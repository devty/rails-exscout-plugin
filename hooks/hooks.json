{
  "description": "Warns when an edit introduces an ActiveRecord association that crosses a domain boundary.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "ruby \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check_cross_domain.rb\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
